# Required: provision an OAuth authorization server separately. No anonymous mode.
# Exact issuer, including its trailing slash where applicable.
TIMELINE_MCP_ISSUER_URL=
TIMELINE_MCP_JWKS_URL=
# Public HTTPS URL of this service, ending in /mcp; also the OAuth resource/audience.
TIMELINE_MCP_RESOURCE_URL=
# Existing human approval screen, without tokens or query parameters.
TIMELINE_MCP_APPROVAL_URL=
# Existing database. PostgreSQL: use a dedicated SELECT-only login.
# SQLite: existing file, mounted read-only; no schema initialization by this service.
TIMELINE_MCP_DATABASE_URL=
# Operator-controlled JSON: trusted provider subject -> existing timeline user_id.
# Example shape only: {"issuer-subject-id":"existing-timeline-user"}
# This map is private configuration and must not be committed with real identities.
TIMELINE_MCP_USER_MAP=
