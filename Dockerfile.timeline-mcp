FROM python:3.12-slim
WORKDIR /app
COPY requirements-timeline-mcp.txt .
RUN pip install --no-cache-dir -r requirements-timeline-mcp.txt \
    && useradd --uid 10001 --create-home app
COPY timeline_mcp.py .
USER 10001:10001
ENV PYTHONUNBUFFERED=1
EXPOSE 8090
CMD ["uvicorn", "timeline_mcp:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
